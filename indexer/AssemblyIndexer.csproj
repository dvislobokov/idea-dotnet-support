<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The indexer of assemblies: reads the metadata of .dll files (NuGet packages, the reference packs of the SDK) and writes an index
    of their public types and static members, one file per assembly, for the plugin to complete what is not imported.

    The plugin carries this file and Program.cs as they are and builds them on the machine of the user (IndexerTool), for the
    framework of the SDK that is there: `-p:IndexerFramework=net10.0` with the SDK 10, `net9.0` with the SDK 9. The reference pack of
    its own framework comes with every SDK, so the build needs no network. Without the property (a build in the repository): net8.0.
    Nothing but the shared framework is referenced: System.Reflection.Metadata is a part of it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(IndexerFramework)' != ''">$(IndexerFramework)</TargetFramework>
    <!-- runs on whatever runtime is newer than the one it is built for -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AssemblyIndexer</AssemblyName>
    <RootNamespace>DotNetSupport.Indexer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <UseAppHost>false</UseAppHost>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/indexer</PathMap>
  </PropertyGroup>
</Project>
