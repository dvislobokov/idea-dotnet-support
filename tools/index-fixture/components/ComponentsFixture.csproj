<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A stand-in for Microsoft.AspNetCore.Components in the tests of Razor's components and tag helpers (RazorTagHelpersTest, RAZOR_PLAN.md
    R5d): the part of its API the compiler's discovery and the generated C# read — IComponent, ComponentBase, [Parameter], RenderFragment,
    EventCallback, RenderTreeBuilder, BindConverter, the [EventHandler] / [BindElement] attributes of EventHandlers / BindAttributes —
    under the real assembly name (the discovery searches only assemblies of ASP.NET Core). Not a part of the plugin; indexed into
    `src/test/resources/index/AspNetCoreComponents.dnix` by tools/index-fixture/fixtures.sh.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.AspNetCore.Components</AssemblyName>
    <RootNamespace>Microsoft.AspNetCore.Components</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0067;CS0649;CS0169;CS0414</NoWarn>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/fixture</PathMap>
  </PropertyGroup>
</Project>
