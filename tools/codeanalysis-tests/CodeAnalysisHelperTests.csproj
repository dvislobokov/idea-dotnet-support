<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the pure parts of CodeAnalysisHelper (helpers/codeanalysis) that need no project and no MSBuild: the rule of the disk cache of
    design-time builds (DesignTimeCache) over a fake disk. Not part of the build of the plugin, no packages:
      dotnet run (project tools/codeanalysis-tests/CodeAnalysisHelperTests.csproj, artifacts path in a temporary folder)
    Exit code 0 when every check passes. Roslyn comes from the SDK as for the helper.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <StartupObject>DotNetSupport.Helpers.CodeAnalysis.Tests.Checks</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseAppHost>false</UseAppHost>
    <SdkRoslyn>$(MSBuildBinPath)/DotnetTools/dotnet-format/</SdkRoslyn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Checks.cs" />
    <Compile Include="../../helpers/codeanalysis/*.cs" />
    <Compile Include="../../helpers/protocol/Protocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(SdkRoslyn)Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(SdkRoslyn)Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.Workspaces" HintPath="$(SdkRoslyn)Microsoft.CodeAnalysis.Workspaces.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" HintPath="$(SdkRoslyn)Microsoft.CodeAnalysis.CSharp.Workspaces.dll" Private="true" />
    <Reference Include="System.Composition.AttributedModel" HintPath="$(SdkRoslyn)System.Composition.AttributedModel.dll" Private="true" />
    <Reference Include="System.Composition.Convention" HintPath="$(SdkRoslyn)System.Composition.Convention.dll" Private="true" />
    <Reference Include="System.Composition.Hosting" HintPath="$(SdkRoslyn)System.Composition.Hosting.dll" Private="true" />
    <Reference Include="System.Composition.Runtime" HintPath="$(SdkRoslyn)System.Composition.Runtime.dll" Private="true" />
    <Reference Include="System.Composition.TypedParts" HintPath="$(SdkRoslyn)System.Composition.TypedParts.dll" Private="true" />
  </ItemGroup>
</Project>
