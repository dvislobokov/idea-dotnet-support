<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>io.github.dotnetsupport</id>
    <name>C# Project Support</name>
    <vendor>dvislobokov</vendor>

    <description><![CDATA[
        Basic support for C# / .NET projects in IntelliJ-based IDEs:
        <ul>
            <li>Rider-like <b>Solution</b> view: solutions (.sln, .slnx), solution folders, projects and their dependencies</li>
            <li>C# syntax highlighting, commenting, brace matching</li>
            <li>MSBuild project files (.csproj, .props, .targets) are treated as XML</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>

    <!-- optional parts: a module is loaded only where its dependencies are (see the descriptor of the module next to META-INF) -->
    <content>
        <module name="io.github.dotnetsupport.roslyn"/>
        <!-- the schema of appsettings*.json, where the JSON plugin is -->
        <module name="io.github.dotnetsupport.jsonschema"/>
    </content>

    <!-- the native C# PSI (csharp-psi-core, csharp-psi-semantic, csharp-psi-ide; CSHARP_PSI_MIGRATION.md): composed into the main jar,
         empty until step 7 moves the code of ../csharp-psi -->
    <xi:include href="/META-INF/csharp-psi-core.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/csharp-psi-semantic.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/csharp-psi-ide.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensions defaultExtensionNs="io.github.dotnetsupport">
        <processAttacher implementation="io.github.dotnetsupport.debugger.DotNetProcessAttacherImpl"/>
    </extensions>

    <extensionPoints>
        <!-- who can attach a debugger to a .NET process: the module with the debugger, where it is loaded -->
        <extensionPoint qualifiedName="io.github.dotnetsupport.processAttacher" interface="io.github.dotnetsupport.run.DotNetProcessAttacher" dynamic="true"/>
        <!-- who changes the namespace of a moved file together with its usages: the module of the language server -->
        <extensionPoint qualifiedName="io.github.dotnetsupport.namespaceAdjuster" interface="io.github.dotnetsupport.lang.CSharpNamespaceAdjuster" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="C#"
                  implementationClass="io.github.dotnetsupport.lang.CSharpFileType"
                  fieldName="INSTANCE"
                  language="C#"
                  extensions="cs;csx"/>
        <fileType name="Visual Studio Solution"
                  implementationClass="io.github.dotnetsupport.solution.SolutionFileType"
                  fieldName="INSTANCE"
                  extensions="sln"/>
        <fileType name="Visual Studio Solution (XML)"
                  implementationClass="io.github.dotnetsupport.solution.SolutionXmlFileType"
                  language="XML"
                  fieldName="INSTANCE"
                  extensions="slnx"/>
        <fileType name="MSBuild"
                  implementationClass="io.github.dotnetsupport.msbuild.MsBuildFileType"
                  language="XML"
                  fieldName="INSTANCE"
                  extensions="csproj;fsproj;vbproj;shproj;proj;props;targets"/>

        <fileType name=".NET XML"
                  implementationClass="io.github.dotnetsupport.msbuild.DotNetXmlFileType"
                  language="XML"
                  fieldName="INSTANCE"
                  extensions="xaml;axaml;resx;nuspec;ruleset;runsettings;config"/>
        <fileIconProvider implementation="io.github.dotnetsupport.DotNetFileIconProvider"/>
        <iconProvider implementation="io.github.dotnetsupport.DotNetDirectoryIconProvider"/>

        <lang.parserDefinition language="C#"
                               implementationClass="io.github.dotnetsupport.lang.CSharpParserDefinition"/>
        <lang.syntaxHighlighterFactory language="C#"
                                       implementationClass="io.github.dotnetsupport.lang.CSharpSyntaxHighlighterFactory"/>
        <annotator language="C#" implementationClass="io.github.dotnetsupport.lang.CSharpIdentifierAnnotator"/>
        <!-- on the declarations CSharpDeclarations finds by tokens -->
        <lang.psiStructureViewFactory language="C#" implementationClass="io.github.dotnetsupport.lang.CSharpStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="io.github.dotnetsupport.lang.CSharpBreadcrumbsProvider"/>
        <!-- a declaration is a named element only for navigation: renaming is the business of the language server -->
        <vetoRenameCondition implementation="io.github.dotnetsupport.lang.CSharpRenameVeto"/>
        <!-- a .cs file moved to another folder gets the namespace of the folder -->
        <moveFileHandler implementation="io.github.dotnetsupport.lang.CSharpMoveFileHandler"/>
        <!-- banners above a C# file: no language server, no project, excluded, not restored -->
        <editorNotificationProvider implementation="io.github.dotnetsupport.lang.CSharpEditorBanners"/>
        <!-- the .NET options of .editorconfig (csharp_*, dotnet_*) that the EditorConfig plugin ships but shows only in Rider -->
        <postStartupActivity implementation="io.github.dotnetsupport.lang.EditorConfigDotNetSupport"/>
        <!-- Alt+Enter on the file: the namespace of the folder, a type into its own file, the file named after its type, a partial part, a test -->
        <intentionAction><language>C#</language><className>io.github.dotnetsupport.lang.AdjustNamespaceIntention</className><category>C#</category></intentionAction>
        <intentionAction><language>C#</language><className>io.github.dotnetsupport.lang.MoveTypeToFileIntention</className><category>C#</category></intentionAction>
        <intentionAction><language>C#</language><className>io.github.dotnetsupport.lang.RenameFileToTypeIntention</className><category>C#</category></intentionAction>
        <intentionAction><language>C#</language><className>io.github.dotnetsupport.lang.AddPartialPartIntention</className><category>C#</category></intentionAction>
        <intentionAction><language>C#</language><className>io.github.dotnetsupport.lang.CreateTestIntention</className><category>C#</category></intentionAction>
        <lang.foldingBuilder language="C#" implementationClass="io.github.dotnetsupport.lang.CSharpFoldingBuilder"/>
        <!-- TODO / FIXME in the comments of C#: the TODO tool window and the highlighting -->
        <todoIndexer filetype="C#" implementationClass="io.github.dotnetsupport.lang.CSharpTodoIndexer"/>
        <indexPatternBuilder implementation="io.github.dotnetsupport.lang.CSharpIndexPatternBuilder"/>
        <fileBasedIndex implementation="io.github.dotnetsupport.lang.CSharpDeclarationIndex"/>
        <gotoClassContributor implementation="io.github.dotnetsupport.lang.CSharpGotoClassContributor"/>
        <gotoSymbolContributor implementation="io.github.dotnetsupport.lang.CSharpGotoSymbolContributor"/>
        <!-- the compiler diagnostics of the last build, in the editor -->
        <externalAnnotator language="C#" implementationClass="io.github.dotnetsupport.build.BuildProblemsAnnotator"/>
        <defaultLiveTemplates file="/liveTemplates/CSharp.xml"/>
        <liveTemplateContext contextId="CSHARP" implementation="io.github.dotnetsupport.lang.CSharpTemplateContext"/>
        <liveTemplateMacro implementation="io.github.dotnetsupport.lang.CSharpTypeNameMacro"/>
        <typedHandler implementation="io.github.dotnetsupport.lang.CSharpDocCommentTypedHandler"/>
        <!-- indentation while typing, by the rules of resources/csharpIndent/rules.json; whole files are formatted by CSharpier / dotnet format -->
        <lineIndentProvider implementation="io.github.dotnetsupport.lang.CSharpLineIndentProvider"/>
        <typedHandler implementation="io.github.dotnetsupport.lang.CSharpBracketTypedHandler"/>
        <!-- `<` of a generic gets its `>`: the brace matcher cannot list a bracket that is an operator as often -->
        <typedHandler implementation="io.github.dotnetsupport.lang.CSharpAngleBracketTypedHandler"/>
        <backspaceHandlerDelegate implementation="io.github.dotnetsupport.lang.CSharpAngleBracketBackspaceHandler"/>
        <!-- `;` typed before the `;` at the end of the line steps over it (the completion of a void method puts `();`) -->
        <typedHandler implementation="io.github.dotnetsupport.lang.CSharpSemicolonTypedHandler"/>
        <enterHandlerDelegate order="first" implementation="io.github.dotnetsupport.lang.CSharpEnterAfterBraceHandler"/>
        <enterHandlerDelegate implementation="io.github.dotnetsupport.lang.CSharpDocCommentEnterHandler"/>
        <!-- Enter inside a // line comment or a /* */ block continues it on the next line (/// has its own handler above) -->
        <enterHandlerDelegate implementation="io.github.dotnetsupport.lang.CSharpCommentEnterHandler"/>
        <!-- Complete Statement (Ctrl+Shift+Enter): add the missing ; for a clear statement and open a new line -->
        <lang.smartEnterProcessor language="C#" implementationClass="io.github.dotnetsupport.lang.CSharpSmartEnterProcessor"/>
        <!-- postfix templates (expr.if, list.foreach, x.return...) and Surround With, by tokens -->
        <codeInsight.template.postfixTemplateProvider language="C#" implementationClass="io.github.dotnetsupport.lang.CSharpPostfixTemplateProvider"/>
        <lang.surroundDescriptor language="C#" implementationClass="io.github.dotnetsupport.lang.CSharpSurroundDescriptor"/>
        <!-- Extend / Shrink Selection (Ctrl+W): structural ranges by brackets and string / comment tokens, on top of the platform's word and line -->
        <extendWordSelectionHandler implementation="io.github.dotnetsupport.lang.CSharpSelectioner"/>
        <!-- highlight the other occurrences of the identifier under the caret, by token text, until the server covers the file -->
        <highlightUsagesHandlerFactory implementation="io.github.dotnetsupport.lang.CSharpHighlightUsagesHandlerFactory"/>
        <!-- Find Usages as in Rider, behind the toggles of the Usages view: usage kind, .NET project, type and member -->
        <usageGroupingRuleProvider implementation="io.github.dotnetsupport.lang.CSharpUsageGroupingRuleProvider"/>
        <fileStructureGroupRuleProvider implementation="io.github.dotnetsupport.lang.CSharpMemberGroupRuleProvider"/>
        <colorSettingsPage implementation="io.github.dotnetsupport.lang.CSharpColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/CSharpDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/CSharpDarcula.xml"/>
        <lang.commenter language="C#"
                        implementationClass="io.github.dotnetsupport.lang.CSharpCommenter"/>
        <lang.braceMatcher language="C#"
                           implementationClass="io.github.dotnetsupport.lang.CSharpBraceMatcher"/>
        <lang.quoteHandler language="C#"
                           implementationClass="io.github.dotnetsupport.lang.CSharpQuoteHandler"/>

        <!-- MSBuild files: completion, documentation and checks from the schema of resources/msbuildSchema -->
        <xml.tagNameProvider implementation="io.github.dotnetsupport.msbuild.MsBuildTagNameProvider"/>
        <completion.contributor language="XML" order="first" implementationClass="io.github.dotnetsupport.msbuild.MsBuildCompletionContributor"/>
        <completion.contributor language="XML" order="first" implementationClass="io.github.dotnetsupport.msbuild.MsBuildPackageCompletionContributor"/>
        <!-- a dot in a package id goes on with the id, it does not pick the selected package -->
        <lookup.charFilter order="first" implementation="io.github.dotnetsupport.msbuild.PackageIdCharFilter"/>
        <annotator language="XML" implementationClass="io.github.dotnetsupport.msbuild.MsBuildAnnotator"/>
        <lang.documentationProvider language="XML" order="first" implementationClass="io.github.dotnetsupport.msbuild.MsBuildDocumentationProvider"/>

        <projectViewPane implementation="io.github.dotnetsupport.view.SolutionViewPane"/>
        <projectViewNodeDecorator implementation="io.github.dotnetsupport.view.BuildOutputDecorator"/>
        <!-- the content of a project as the SDK sees it: Remove / DefaultItemExcludes hide, DependentUpon nests; Solution view only -->
        <treeStructureProvider implementation="io.github.dotnetsupport.view.ProjectContentStructureProvider"/>
        <projectViewNestingRulesProvider implementation="io.github.dotnetsupport.view.DotNetNestingRulesProvider"/>
        <postStartupActivity implementation="io.github.dotnetsupport.view.SolutionViewActivator"/>
        <postStartupActivity implementation="io.github.dotnetsupport.view.ToolWindowsSetup"/>
        <!-- the page about the plugin, once after the installation and after an update -->
        <postStartupActivity implementation="io.github.dotnetsupport.welcome.WelcomePageActivity"/>
        <!-- New Solution of the Welcome screen right after New Project, which is a different action in IDEA and in GoLand / PyCharm / WebStorm -->
        <dynamicActionConfigurationCustomizer implementation="io.github.dotnetsupport.newproject.WelcomeNewSolutionPlacement"/>
        <!-- the index of the assemblies of the projects, made in the background by the indexer the plugin builds on this machine -->
        <postStartupActivity implementation="io.github.dotnetsupport.index.AssemblyIndexStartup"/>
        <postStartupActivity implementation="io.github.dotnetsupport.build.VisualStudioToolset$Detect"/>
        <!-- what the lines of the sources allocate, measured in the running program and written at the end of the lines -->
        <postStartupActivity implementation="io.github.dotnetsupport.allocations.AllocationsStartup"/>
        <editor.linePainter implementation="io.github.dotnetsupport.allocations.AllocationsLinePainter"/>
        <!-- static members of types that are not imported, by the bare name: WriteLi -> Console.WriteLine and the using -->
        <completion.contributor language="C#" implementationClass="io.github.dotnetsupport.index.ImportCompletionContributor"/>
        <notificationGroup id=".NET" displayType="BALLOON"/>
        <projectConfigurable parentId="tools" id="io.github.dotnetsupport.settings" key="page.dotnet" bundle="messages.DotNetBundle"
                             instance="io.github.dotnetsupport.settings.DotNetSettingsConfigurable"/>
        <!-- the pages of Rider under Tools | .NET, with the options the plugin has something behind -->
        <projectConfigurable parentId="io.github.dotnetsupport.settings" id="io.github.dotnetsupport.settings.build" key="page.build" bundle="messages.DotNetBundle"
                             instance="io.github.dotnetsupport.build.DotNetBuildConfigurable"/>
        <applicationConfigurable parentId="io.github.dotnetsupport.settings" id="io.github.dotnetsupport.settings.nuget" key="page.nuget" bundle="messages.DotNetBundle"
                                 instance="io.github.dotnetsupport.nuget.NuGetSettingsConfigurable"/>
        <applicationConfigurable parentId="io.github.dotnetsupport.settings" id="io.github.dotnetsupport.settings.coverage" key="page.coverage" bundle="messages.DotNetBundle"
                                 instance="io.github.dotnetsupport.coverage.CoverageSettingsConfigurable"/>
        <projectConfigurable parentId="io.github.dotnetsupport.settings" id="io.github.dotnetsupport.settings.debugger" key="page.debugger" bundle="messages.DotNetBundle"
                             instance="io.github.dotnetsupport.settings.DotNetDebuggerConfigurable"/>
        <projectConfigurable parentId="io.github.dotnetsupport.settings" id="io.github.dotnetsupport.settings.languageServer" key="page.languageServer" bundle="messages.DotNetBundle"
                             instance="io.github.dotnetsupport.lsp.RoslynLanguageServerConfigurable"/>
        <langCodeStyleSettingsProvider implementation="io.github.dotnetsupport.lang.CSharpCodeStyleSettingsProvider"/>
        <projectViewNodeDecorator implementation="io.github.dotnetsupport.coverage.CoverageProjectViewDecorator"/>
        <postStartupActivity implementation="io.github.dotnetsupport.build.BuildAfterSolutionIsLoaded"/>
        <postStartupActivity implementation="io.github.dotnetsupport.sdk.SdkCheckActivity"/>
        <postStartupActivity implementation="io.github.dotnetsupport.run.DevCertCheckActivity"/>

        <configurationType implementation="io.github.dotnetsupport.run.DotNetConfigurationType"/>
        <configurationType implementation="io.github.dotnetsupport.publish.DotNetPublishConfigurationType"/>
        <!-- the Services tool window lists the .NET Project configurations, with the address a web application listens on -->
        <runDashboardDefaultTypesProvider implementation="io.github.dotnetsupport.run.DotNetRunDashboardTypes"/>
        <runDashboardCustomizer implementation="io.github.dotnetsupport.run.DotNetRunDashboardCustomizer"/>
        <!-- F2 on the node of a project is Rename Project (Delete is Remove from Solution: the delete provider of the pane) -->
        <renameHandler implementation="io.github.dotnetsupport.view.ProjectNodeRenameHandler"/>
        <consoleFilterProvider implementation="io.github.dotnetsupport.run.DotNetConsoleFilterProvider"/>
        <console.folding implementation="io.github.dotnetsupport.run.DotNetStackTraceFolding"/>
        <formattingService implementation="io.github.dotnetsupport.format.DotNetFormattingService"/>
        <postStartupActivity implementation="io.github.dotnetsupport.run.DotNetRunConfigurationStartupActivity"/>
        <runConfigurationProducer implementation="io.github.dotnetsupport.run.DotNetRunConfigurationProducer"/>
        <runLineMarkerContributor language="C#"
                                  implementationClass="io.github.dotnetsupport.run.MainMethodRunLineMarkerContributor"/>
        <programRunner implementation="io.github.dotnetsupport.testing.DotNetTestRunner" order="first"/>
        <!-- the debugger: the plugin's own DAP client on the XDebugger API, which every IDE has (the DAP module of the platform is
             absent from IntelliJ IDEA Community and its forks) -->
        <programRunner implementation="io.github.dotnetsupport.debugger.DotNetDebugRunner"/>
        <xdebugger.breakpointType implementation="io.github.dotnetsupport.debugger.CSharpLineBreakpointType"/>
        <xdebugger.breakpointType implementation="io.github.dotnetsupport.debugger.DotNetExceptionBreakpointType"/>
        <xdebugger.attachDebuggerProvider implementation="io.github.dotnetsupport.debugger.DotNetAttachDebuggerProvider"/>
        <!-- names of the stopped program in Evaluate, watches and breakpoint conditions; first, and it stops the others there -->
        <!-- the case of what is typed does not matter in C#: the first of all, the ones after it get its matcher -->
        <completion.contributor language="C#" id="dotnetCaseInsensitive" order="first" implementationClass="io.github.dotnetsupport.lang.CSharpCaseInsensitiveCompletion"/>
        <completion.contributor language="C#" order="first, after dotnetCaseInsensitive" implementationClass="io.github.dotnetsupport.debugger.DotNetExpressionCompletionContributor"/>
        <!-- gray text of a declaration that continues one way only: { get; set; }, new(), _name = name; -->
        <inline.completion.provider implementation="io.github.dotnetsupport.lang.CSharpGhostTextProvider"/>
        <registryKey key="dotnet.debugger.adapter.log" defaultValue="true"
                     description="Write the log of the dotnet-debugger adapter for every debug session (menu .NET | Show Debugger Logs)"/>
        <registryKey key="dotnet.debugger.protocol.trace" defaultValue="false"
                     description="Write every DAP message of the debug sessions next to the debugger logs (menu .NET | Trace Debugger Protocol)"/>
        <registryKey key="dotnet.debugger.attach.netFramework" defaultValue="false"
                     description="Offer .NET Framework processes in Run | Attach to Process: managed executables and hosts with the desktop CLR loaded (w3wp, Office), found by the diagnostics helper (needs a debug adapter that debugs the desktop CLR)"/>
        <stepsBeforeRunProvider implementation="io.github.dotnetsupport.run.BuildProjectBeforeRunTaskProvider"/>
        <runConfigurationProducer implementation="io.github.dotnetsupport.testing.DotNetTestConfigurationProducer"/>
        <runLineMarkerContributor language="C#"
                                  implementationClass="io.github.dotnetsupport.testing.DotNetTestRunLineMarkerContributor"/>
        <iconMapper mappingFile="DotNetIconMappings.json"/>
        <!-- the id is not "Endpoints": IntelliJ IDEA has a tool window of its own with that id (Microservices), and the second
             registration fails. The name on the stripe is still "Endpoints": the factory sets it. -->
        <toolWindow id="DotNetEndpoints" anchor="bottom" icon="AllIcons.General.Web"
                    factoryClass="io.github.dotnetsupport.endpoints.EndpointsToolWindowFactory"/>
        <codeInsight.lineMarkerProvider language="C#" implementationClass="io.github.dotnetsupport.endpoints.EndpointLineMarkerProvider"/>
        <toolWindow id="Unit Tests" anchor="bottom" canCloseContents="true" icon="/icons/unitTestsToolWindow.svg"
                    factoryClass="io.github.dotnetsupport.testing.TestExplorerToolWindowFactory"/>
        <toolWindow id="NuGet" anchor="bottom" icon="/icons/nugetToolWindow.svg"
                    factoryClass="io.github.dotnetsupport.nuget.NuGetToolWindowFactory"/>
        <toolWindow id=".NET Monitor" anchor="right" icon="/icons/monitorToolWindow.svg"
                    factoryClass="io.github.dotnetsupport.monitor.MonitorToolWindowFactory"/>
        <codeInsight.lineMarkerProvider language="C#" implementationClass="io.github.dotnetsupport.ef.EfLineMarkerProvider"/>
        <toolWindow id="EF Core" anchor="bottom" icon="AllIcons.Nodes.DataTables"
                    factoryClass="io.github.dotnetsupport.ef.EfToolWindowFactory"/>
        <toolWindow id=".NET Coverage" anchor="right" secondary="true" icon="AllIcons.General.RunWithCoverage"
                    factoryClass="io.github.dotnetsupport.coverage.CoverageToolWindowFactory"/>
        <!-- the IL of the code at the caret, as in Rider; a stripe button only with a .NET solution -->
        <toolWindow id="IL Viewer" anchor="right" icon="AllIcons.FileTypes.BinaryData"
                    factoryClass="io.github.dotnetsupport.il.IlViewerToolWindowFactory"/>
        <!-- the journal of the plugin; not on the stripe until .NET | Plugin Logs asks for it -->
        <toolWindow id="Plugin Logs" anchor="bottom" icon="AllIcons.Debugger.Console" doNotActivateOnStart="true"
                    factoryClass="io.github.dotnetsupport.cli.PluginLogsToolWindowFactory"/>

        <directoryProjectGenerator implementation="io.github.dotnetsupport.newproject.DotNetProjectGenerator"/>
        <!-- the New Project dialog of IntelliJ IDEA lists generator wizards, not directory generators -->
        <newProjectWizard.generator implementation="io.github.dotnetsupport.newproject.DotNetNewProjectWizard"/>
        <internalFileTemplate name="CSharp Class"/>
        <internalFileTemplate name="CSharp Interface"/>
        <internalFileTemplate name="CSharp Record"/>
        <internalFileTemplate name="CSharp Struct"/>
        <internalFileTemplate name="CSharp Enum"/>
        <defaultTemplatePropertiesProvider implementation="io.github.dotnetsupport.templates.CSharpTemplatePropertiesProvider"/>
    </extensions>

    <actions>
        <action id="DotNet.NewCSharpFile" class="io.github.dotnetsupport.templates.CreateCSharpFileAction">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>

        <!-- Rider's New Solution window; on top of File | New, where Rider has it -->
        <action id="DotNet.NewSolution" class="io.github.dotnetsupport.newproject.NewSolutionAction" text="New Solution..."
                description="Create a .NET solution with a project from a template, or an empty solution" icon="/icons/solution.svg">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
        <!-- the same on the Welcome screen, with the icon of New Project: there no project is open. Put right after New Project by
             WelcomeNewSolutionPlacement: no anchor of this file is New Project in every IDE -->
        <action id="DotNet.NewSolution.Welcome" class="io.github.dotnetsupport.newproject.NewSolutionAction" text="New Solution"
                description="Create a .NET solution with a project from a template, or an empty solution" icon="AllIcons.Welcome.CreateNewProjectTab"/>

        <group id="DotNet.NewItems" class="io.github.dotnetsupport.templates.NewDotNetItemGroup"
               text=".NET" description="C#, ASP.NET, Razor, test, EF Core and configuration items" popup="true">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="DotNet.NewCSharpFile"/>
        </group>

        <group id="DotNet.SolutionViewPopup">
            <separator/>
            <action id="DotNet.ReloadSolution" class="io.github.dotnetsupport.actions.ReloadSolutionAction" text="Reload Solution"
                    description="Read the solution and its projects from the disk again and load them into the language server anew"
                    icon="AllIcons.Actions.Refresh">
                <!-- next to the eye in the title of the tool window; shows itself for the Solution view only -->
                <add-to-group group-id="ProjectViewToolbar" anchor="first"/>
            </action>
            <action id="DotNet.ReloadProject" class="io.github.dotnetsupport.actions.ReloadProjectAction" text="Reload Project"
                    description="Read the project from the disk again: its file, its folder, what restore has resolved for it"
                    icon="AllIcons.Actions.Refresh"/>
            <group id="DotNet.AddToSolution" class="io.github.dotnetsupport.actions.AddToSolutionGroup"
                   text="Add" popup="true" icon="AllIcons.General.Add">
                <action id="DotNet.AddNewProject" class="io.github.dotnetsupport.actions.AddNewProjectToSolutionAction"
                        text="New Project..."/>
                <action id="DotNet.AddExistingProject" class="io.github.dotnetsupport.actions.AddExistingProjectAction"
                        text="Existing Project..."/>
                <action id="DotNet.NewSolutionFolder" class="io.github.dotnetsupport.actions.NewSolutionFolderAction"
                        text="New Solution Folder..."/>
                <action id="DotNet.AddProjectReference" class="io.github.dotnetsupport.actions.AddProjectReferenceAction"
                        text="Project Reference..."/>
                <action id="DotNet.AddAssemblyReference" class="io.github.dotnetsupport.actions.AddAssemblyReferenceAction"
                        text="Assembly Reference..." description="Reference a .dll by its path (HintPath)"/>
            </group>
            <action id="DotNet.RenameProject" class="io.github.dotnetsupport.actions.RenameProjectAction" text="Rename Project..."
                    description="Rename the project file and optionally its directory; the solution, project references and run configurations follow"/>
            <action id="DotNet.EditProjectFile" class="io.github.dotnetsupport.actions.EditProjectFileAction" text="Edit Project File"
                    icon="AllIcons.Actions.Edit" description="Open the .csproj of the project or the solution file in the editor"/>
            <action id="DotNet.ProjectProperties" class="io.github.dotnetsupport.actions.ProjectPropertiesAction" text="Properties..."
                    icon="AllIcons.General.Settings" description="Target frameworks, output type, nullable, language version, warnings, package metadata of the project"/>
            <action id="DotNet.RunProject" class="io.github.dotnetsupport.run.RunSelectedProjectAction" text="Run Project"
                    icon="AllIcons.Actions.Execute" description="Run the selected executable or test project"/>
            <action id="DotNet.DebugProject" class="io.github.dotnetsupport.run.DebugSelectedProjectAction" text="Debug Project"
                    icon="AllIcons.Actions.StartDebugger" description="Debug the selected executable project"/>
            <action id="DotNet.BuildSelected" class="io.github.dotnetsupport.build.BuildSelected" text="Build"
                    icon="AllIcons.Actions.Compile"/>
            <action id="DotNet.RebuildSelected" class="io.github.dotnetsupport.build.RebuildSelected" text="Rebuild"/>
            <action id="DotNet.Publish" class="io.github.dotnetsupport.publish.PublishAction" text="Publish..." icon="AllIcons.Nodes.Deploy"
                    description="dotnet publish of the project to a folder or a container image: configuration, runtime, self-contained, single file, trimming, ReadyToRun, a .pubxml profile"/>
            <action id="DotNet.ManageNuGet" class="io.github.dotnetsupport.nuget.ManageNuGetPackagesAction"
                    text="Manage NuGet Packages..." icon="/icons/nuget.svg"/>
            <group id="DotNet.EfCore" class="io.github.dotnetsupport.ef.EfCoreGroup" text="EF Core" popup="true">
                <action id="DotNet.EfAddMigration" class="io.github.dotnetsupport.ef.EfAction$AddMigration" text="Add Migration..."
                        description="dotnet ef migrations add"/>
                <action id="DotNet.EfRemoveMigration" class="io.github.dotnetsupport.ef.EfAction$RemoveMigration" text="Remove Last Migration..."
                        description="dotnet ef migrations remove"/>
                <separator/>
                <action id="DotNet.EfUpdateDatabase" class="io.github.dotnetsupport.ef.EfAction$UpdateDatabase" text="Update Database..."
                        description="dotnet ef database update: apply the migrations, or revert to an earlier one"/>
                <action id="DotNet.EfGenerateScript" class="io.github.dotnetsupport.ef.EfAction$GenerateScript" text="Generate SQL Script..."
                        description="dotnet ef migrations script"/>
                <action id="DotNet.EfDropDatabase" class="io.github.dotnetsupport.ef.EfAction$DropDatabase" text="Drop Database..."
                        description="dotnet ef database drop, after showing which database it is"/>
                <separator/>
                <action id="DotNet.EfCreateBundle" class="io.github.dotnetsupport.ef.EfAction$CreateBundle" text="Create Migration Bundle..."
                        description="dotnet ef migrations bundle: an executable that applies the migrations without the SDK and the sources"/>
                <action id="DotNet.EfScaffold" class="io.github.dotnetsupport.ef.EfAction$ScaffoldDbContext" text="Scaffold DbContext from Database..."
                        description="dotnet ef dbcontext scaffold: entity classes and a DbContext from an existing database"/>
                <separator/>
                <action id="DotNet.EfShowMigrations" class="io.github.dotnetsupport.ef.ShowEfToolWindowAction" text="Show Migrations"
                        icon="AllIcons.Nodes.DataTables" description="The EF Core tool window: migrations of every DbContext with their status in the database"/>
                <action id="DotNet.EfInstallTool" class="io.github.dotnetsupport.ef.InstallEfToolAction" text="Install or Update dotnet-ef"/>
            </group>
            <action id="DotNet.RunTestsWithCoverage" class="io.github.dotnetsupport.testing.RunTestsWithCoverageAction"
                    text="Run Tests with Coverage" icon="AllIcons.General.RunWithCoverage"/>
            <action id="DotNet.RunMsBuildTarget" class="io.github.dotnetsupport.build.RunMsBuildTargetAction"
                    text="Run MSBuild Target..." icon="AllIcons.Nodes.Target"/>
            <action id="DotNet.AnalyzeUpgrade" class="io.github.dotnetsupport.upgrade.AnalyzeUpgradeAction"
                    text="Analyze Upgrade to Newer .NET..." description="Run the .NET Upgrade Assistant analysis: packages, project properties and APIs that block a newer target framework"/>
            <action id="DotNet.CalculateCodeMetrics" class="io.github.dotnetsupport.metrics.CalculateCodeMetricsAction"
                    text="Calculate Code Metrics" icon="AllIcons.Toolwindows.ToolWindowAnalyzeDataflow"
                    description="Maintainability index, cyclomatic complexity, depth of inheritance, class coupling and lines of code of the project or solution, as Analyze | Calculate Code Metrics of Visual Studio"/>
            <action id="DotNet.FormatSelected" class="io.github.dotnetsupport.format.FormatSelectedAction" text="Format"
                    description="Format the project or solution with the formatter of the repository: CSharpier or dotnet format"/>
            <action id="DotNet.VerifyFormatting" class="io.github.dotnetsupport.format.VerifyFormattingAction" text="Verify Formatting"
                    description="Check that everything is formatted, the way a CI does: csharpier check / dotnet format --verify-no-changes"/>
            <action id="DotNet.CleanSelected" class="io.github.dotnetsupport.build.CleanSelected" text="Clean"/>
            <action id="DotNet.ConvertToSlnx" class="io.github.dotnetsupport.actions.ConvertSolutionToSlnxAction"
                    text="Convert to .slnx..."/>
            <action id="DotNet.RemoveFromSolution" class="io.github.dotnetsupport.actions.RemoveProjectFromSolutionAction"
                    text="Remove from Solution..."/>
            <separator/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="WeighingNewGroup"/>
        </group>

        <action id="DotNet.InsertGuid" class="io.github.dotnetsupport.actions.InsertGuidAction"
                text="Insert New GUID" description="Insert a new GUID at every caret">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>

        <action id="DotNet.BuildConfiguration" class="io.github.dotnetsupport.build.BuildConfigurationSelector"
                text="Build Configuration" description="Configuration and target framework for build, run and tests">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
            <add-to-group group-id="NavBarToolBar" anchor="first"/>
        </action>
        <action id="DotNet.AnalyzeStackTrace" class="io.github.dotnetsupport.run.AnalyzeDotNetStackTraceAction"
                text="Analyze .NET Stack Trace..." description="Paste a stack trace and navigate its frames"/>

        <action id="DotNet.ShowAllFiles" class="io.github.dotnetsupport.view.ShowAllFilesAction"
                text="Show All Files" description="Show bin, obj and the project files in the Solution view" icon="AllIcons.Actions.ToggleVisibility">
            <add-to-group group-id="ProjectView.ToolWindow.SecondaryActions" anchor="first"/>
            <!-- the eye of Rider in the title of the tool window; the action shows itself for the Solution view only -->
            <add-to-group group-id="ProjectViewToolbar" anchor="first"/>
        </action>

        <!-- a menu of the main menu bar, next to Tools -->
        <group id="DotNet.MainMenu" text=".NET" popup="true">
            <reference ref="DotNet.RunProject"/>
            <reference ref="DotNet.DebugProject"/>
            <separator/>
            <action id="DotNet.BuildSolution" class="io.github.dotnetsupport.build.BuildSolution" text="Build Solution"
                    icon="AllIcons.Actions.Compile"/>
            <action id="DotNet.RebuildSolution" class="io.github.dotnetsupport.build.RebuildSolution" text="Rebuild Solution"/>
            <action id="DotNet.CleanSolution" class="io.github.dotnetsupport.build.CleanSolution" text="Clean Solution"/>
            <action id="DotNet.BuildPerformance" class="io.github.dotnetsupport.build.BuildPerformanceAction"
                    text="Measure Build Performance" description="Rebuild with the MSBuild performance summary: the slowest targets and tasks"/>
            <reference ref="DotNet.Publish"/>
            <separator/>
            <group id="DotNet.NuGet" text="NuGet" popup="true" icon="/icons/nuget.svg">
                <action id="DotNet.NuGet.QuickList" class="io.github.dotnetsupport.nuget.NuGetQuickListAction" text="NuGet Quick List"
                        description="Popup with the NuGet actions">
                    <keyboard-shortcut keymap="$default" first-keystroke="alt shift N"/>
                </action>
                <separator/>
                <action id="DotNet.RestoreSolution" class="io.github.dotnetsupport.build.RestoreSolution" text="NuGet _Restore"
                        icon="AllIcons.Actions.Download"/>
                <action id="DotNet.NuGet.ForceRestore" class="io.github.dotnetsupport.nuget.NuGetForceRestoreAction" text="NuGet _Force Restore"
                        icon="AllIcons.Actions.Download" description="dotnet restore --force --no-cache: resolve every dependency again"/>
                <action id="DotNet.NuGet.OpenPackagesFolder" class="io.github.dotnetsupport.nuget.OpenNuGetPackagesFolderAction"
                        text="Open 'packages' F_older" description="Open the global packages folder in the file manager"/>
                <separator/>
                <action id="DotNet.NuGet.ManageForSolution" class="io.github.dotnetsupport.nuget.ManageNuGetPackagesForSolutionAction"
                        text="Manage NuGet Packages for Solution"/>
                <separator/>
                <action id="DotNet.NuGet.UpgradeSolution" class="io.github.dotnetsupport.nuget.UpgradePackagesInSolutionAction"
                        text="Upgrade Packages in Solution" icon="AllIcons.Actions.Upload"
                        description="Move every package of the solution to its latest stable version"/>
                <action id="DotNet.NuGet.Consolidate" class="io.github.dotnetsupport.nuget.ConsolidatePackageVersionsAction"
                        text="Consolidate Package Versions" icon="AllIcons.Actions.Collapseall"
                        description="Bring packages referenced at different versions across the solution's projects to the highest version used"/>
                <separator/>
                <action id="DotNet.NuGet.ShowToolWindow" class="io.github.dotnetsupport.nuget.ShowNuGetToolWindowAction" text="Show NuGet Tool Window"/>
                <action id="DotNet.NuGet.ShowPackages" class="io.github.dotnetsupport.nuget.ShowNuGetPackagesAction" text="Show NuGet Packages"/>
                <action id="DotNet.NuGet.ShowSources" class="io.github.dotnetsupport.nuget.ShowNuGetSourcesAction" text="Show NuGet Sources"/>
                <action id="DotNet.NuGet.ShowFolders" class="io.github.dotnetsupport.nuget.ShowNuGetFoldersAction" text="Show NuGet Folders"/>
                <action id="DotNet.NuGet.ShowLog" class="io.github.dotnetsupport.nuget.ShowNuGetLogAction" text="Show NuGet Log"/>
                <separator/>
                <action id="DotNet.NuGet.Settings" class="io.github.dotnetsupport.nuget.OpenNuGetConfigAction" text="NuGet Settings"
                        icon="AllIcons.General.Settings" description="Open the nuget.config that applies to the solution"/>
            </group>
            <reference ref="DotNet.EfCore"/>
            <separator/>
            <reference ref="DotNet.NewSolution"/>
            <action id="DotNet.NewProject" class="io.github.dotnetsupport.actions.NewDotNetProjectAction"
                    text="New .NET Project..."/>
            <action id="DotNet.Monitor" class="io.github.dotnetsupport.monitor.ShowMonitorAction"
                    text="Monitor .NET Process" description="CPU, memory, GC, requests and exceptions of a running .NET process"/>
            <!-- next to the monitor, where what is measured in a running program is looked for; and in the menu of the editor of a C# file -->
            <action id="DotNet.Allocations" class="io.github.dotnetsupport.allocations.ToggleAllocationsAction" text="Show Allocations in Editor"
                    description="Listen to the program started from the IDE and write at the end of every line what it allocates: bytes and objects a second, types, share">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action id="DotNet.IlViewer" class="io.github.dotnetsupport.il.ShowIlViewerAction" text="IL Viewer" icon="AllIcons.FileTypes.BinaryData"
                    description="The IL of the code at the caret, from the last build of the project: the C# line and its instructions light up together"/>
            <action id="DotNet.RunCSharpFile" class="io.github.dotnetsupport.run.RunCSharpFileAction" text="Run C# File with dotnet"
                    description="dotnet run on a standalone .cs file (a file-based app, .NET 10+); shown for a .cs file that no project owns">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action id="DotNet.CreateUserJwt" class="io.github.dotnetsupport.run.CreateUserJwtAction" text="Insert Development JWT"
                    description="dotnet user-jwts create for the ASP.NET Core project; inserts an Authorization: Bearer header with the token at the caret of a .http file">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
            <action id="DotNet.Environment" class="io.github.dotnetsupport.sdk.DotNetEnvironmentAction"
                    text=".NET on This Machine..." description="SDKs and runtimes with their support status, dotnet --info, global.json"/>
            <reference ref="DotNet.FormatSelected"/>
            <reference ref="DotNet.VerifyFormatting"/>
            <reference ref="DotNet.AnalyzeUpgrade"/>
            <reference ref="DotNet.CalculateCodeMetrics"/>
            <reference ref="DotNet.InsertGuid"/>
            <reference ref="DotNet.AnalyzeStackTrace"/>
            <separator/>
            <reference ref="DotNet.ReloadSolution"/>
            <reference ref="DotNet.ReloadProject"/>
            <separator/>
            <action id="DotNet.Welcome" class="io.github.dotnetsupport.welcome.ShowWelcomePageAction" text="Welcome to C# Project Support"
                    description="What the plugin can do and where to start"/>
            <action id="DotNet.Documentation" class="io.github.dotnetsupport.welcome.ShowDocumentationAction" text="Plugin Documentation"
                    description="How to work with the plugin: the menus, the tool windows, every page of the settings, where things are kept, what to do when something does not work"/>
            <action id="DotNet.SuggestionStats" class="io.github.dotnetsupport.suggest.ShowSuggestionStatsAction" text="Suggestion Statistics"
                    description="How often the gray text and the items of the completion list are shown and taken, counted on this machine"/>
            <action id="DotNet.PluginLogs" class="io.github.dotnetsupport.cli.ShowPluginLogsWindowAction" text="Plugin Logs"
                    description="The journal of the plugin: what it started, what came back, what failed and why; nothing of the IDE in it"/>
            <action id="DotNet.ShowPluginLogs" class="io.github.dotnetsupport.cli.ShowPluginLogsAction" text="Open Logs Folder"
                    description="Open ~/idea-dotnet-logs: the journal of the plugin, every dotnet command with its output, the logs of the debugger, the language server and the builds"/>
            <action id="DotNet.Debugger.ShowLogs" class="io.github.dotnetsupport.debugger.ShowDebuggerLogsAction" text="Show Debugger Logs"
                    description="Open the directory with the logs of the debug adapter and the traces of the protocol"/>
            <action id="DotNet.Debugger.TraceProtocol" class="io.github.dotnetsupport.debugger.TraceDebuggerProtocolAction" text="Trace Debugger Protocol"
                    description="Write every DAP message of the debug sessions that start from now on next to the debugger logs"/>
            <!-- a diagnostic: is the LSP / DAP API of the platform there in this IDE and with this license -->
            <action id="DotNet.PlatformApiProbe" class="io.github.dotnetsupport.probe.PlatformApiProbeAction"
                    text="Probe Platform LSP / DAP API..." description="Check which LSP and DAP API of the platform this IDE has; the result can be copied as JSON"/>
            <add-to-group group-id="MainMenu" anchor="after" relative-to-action="ToolsMenu"/>
        </group>

        <!-- Set Next Statement of Rider: next to Run to Cursor in the editor menu while debugging -->
        <action id="DotNet.Debugger.SetNextStatement" class="io.github.dotnetsupport.debugger.SetNextStatementAction" text="Set Next Statement"
                icon="AllIcons.Actions.Forward" description="Make the line under the caret the next one to run, without running the code in between">
            <add-to-group group-id="EditorPopupMenuDebug" anchor="after" relative-to-action="ForceRunToCursor"/>
        </action>
    </actions>

    <projectListeners>
        <!-- what is chosen in the completion list of a C# file and where it stood: the statistics of suggestions -->
        <listener class="io.github.dotnetsupport.suggest.CompletionAcceptListener"
                  topic="com.intellij.codeInsight.lookup.LookupManagerListener"/>
        <listener class="io.github.dotnetsupport.monitor.DotNetProcessStartListener"
                  topic="com.intellij.execution.ExecutionListener"/>
        <listener class="io.github.dotnetsupport.view.SolutionFilesListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="io.github.dotnetsupport.nuget.NuGetAutoRestore$Listener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <!-- MsBuildHost evaluates again the projects of the old format whose files or imports have changed -->
        <listener class="io.github.dotnetsupport.msbuild.MsBuildEvaluation$Listener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
</idea-plugin>
