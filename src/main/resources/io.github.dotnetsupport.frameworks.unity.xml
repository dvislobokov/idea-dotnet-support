<!-- A framework module of the plugin (RAZOR_PLAN.md, "Модульность"): Unity (UNITY_PLAN.md). Classes: io.github.dotnetsupport.frameworks.unity only;
     the core of C# knows nothing of them and hears from them through its extension points (io.github.dotnetsupport.*). -->
<idea-plugin package="io.github.dotnetsupport.frameworks.unity">
    <extensions defaultExtensionNs="io.github.dotnetsupport">
        <solutionLayout implementation="io.github.dotnetsupport.frameworks.unity.UnitySolutionLayout"/>
        <!-- "Event function" / "Set by Unity" / "Unity script" in place of "no usages" -->
        <csharpImplicitUsage implementation="io.github.dotnetsupport.frameworks.unity.UnityImplicitUsage"/>
        <!-- [FormerlySerializedAs("old")] on the rename of a serialized field the scenes set -->
        <csharpRenameParticipant implementation="io.github.dotnetsupport.frameworks.unity.UnityFormerlySerializedAs"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- the asset index: the components, UnityEvent calls and animation events of the scenes, prefabs and assets; the GUIDs of the .meta files -->
        <fileBasedIndex implementation="io.github.dotnetsupport.frameworks.unity.UnityAssetUsageIndex"/>
        <fileBasedIndex implementation="io.github.dotnetsupport.frameworks.unity.UnityMetaGuidIndex"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- the Solution view: Library / Temp / Logs / obj and the .meta files out of the tree, the Unity icon and the editor's version on the solution -->
        <treeStructureProvider implementation="io.github.dotnetsupport.frameworks.unity.UnityTreeStructureProvider"/>
        <projectViewNodeDecorator implementation="io.github.dotnetsupport.frameworks.unity.UnitySolutionDecorator"/>
        <!-- the inspections of Unity (Settings | Editor | Inspections | C# | Unity), in the files of a Unity project only -->
        <localInspection language="C#" shortName="UnityObjectNullPropagation" displayName="Null propagation on a Unity object"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.dotnetsupport.frameworks.unity.UnityObjectNullPropagationInspection"/>
        <localInspection language="C#" shortName="UnityCompareTag" displayName="String comparison of a tag instead of CompareTag"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.dotnetsupport.frameworks.unity.UnityCompareTagInspection"/>
        <localInspection language="C#" shortName="UnityRedundantSerializeField" displayName="Redundant SerializeField attribute"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.dotnetsupport.frameworks.unity.UnityRedundantSerializeFieldInspection"/>
        <localInspection language="C#" shortName="UnityEventFunctionSignature" displayName="Incorrect event function name or signature"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.dotnetsupport.frameworks.unity.UnityEventFunctionSignatureInspection"/>
        <localInspection language="C#" shortName="UnityExpensiveCallInFrame" displayName="Expensive call in a method called every frame"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="io.github.dotnetsupport.frameworks.unity.UnityExpensiveCallInFrameInspection"/>
        <localInspection language="C#" shortName="UnityGetComponentType" displayName="GetComponent of a type that is not a component"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="ERROR"
                         implementationClass="io.github.dotnetsupport.frameworks.unity.UnityGetComponentTypeInspection"/>
        <localInspection language="C#" shortName="UnityUnknownName" displayName="Tag, layer, scene or input axis not defined in the project"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.dotnetsupport.frameworks.unity.UnityUnknownNameInspection"/>
        <!-- tags, layers, scenes, axes of ProjectSettings in CompareTag("…"), NameToLayer("…"), LoadScene("…"), Input.GetAxis("…") -->
        <completion.contributor language="C#" order="first" implementationClass="io.github.dotnetsupport.frameworks.unity.UnityStringCompletion"/>
        <!-- the components first in GetComponent<…>, AddComponent<…>, [RequireComponent(typeof(…))] -->
        <!-- before the case-insensitive wrapper of the core: it runs every other contributor, and this one leaves out their items of the same names -->
        <completion.contributor language="C#" order="first, before dotnetCaseInsensitive" implementationClass="io.github.dotnetsupport.frameworks.unity.UnityComponentCompletion"/>
        <!-- the .meta of an asset follows it on Rename and Move: the GUID the scenes refer to the script by stays -->
        <refactoring.elementListenerProvider implementation="io.github.dotnetsupport.frameworks.unity.UnityMetaFilesListenerProvider"/>
        <!-- sfield, coroutine, menuitem, header: in the member list of a type, in a Unity project only -->
        <defaultLiveTemplates file="/liveTemplates/Unity.xml"/>
        <liveTemplateContext contextId="UNITY_MEMBER" baseContextId="CSHARP_MEMBER" implementation="io.github.dotnetsupport.frameworks.unity.UnityMemberTemplateContext"/>
        <!-- the Unity icon on the event functions; the ones called every frame say so -->
        <codeInsight.lineMarkerProvider language="C#" implementationClass="io.github.dotnetsupport.frameworks.unity.UnityEventFunctionLineMarkerProvider"/>
        <!-- `Upd` in the body of a MonoBehaviour → `private void Update() { }`: the event functions of the class's Unity base -->
        <completion.contributor language="C#" order="first" implementationClass="io.github.dotnetsupport.frameworks.unity.UnityEventFunctionCompletion"/>
        <!-- the link with the Unity editor (UNITY_PLAN.md, "Интеграция с редактором"): the package in Packages/, the state of the editor in
             the status bar, Play / Pause / Step / Refresh, the editor refreshing what the IDE saves -->
        <postStartupActivity implementation="io.github.dotnetsupport.frameworks.unity.UnityEditorStartup"/>
        <configurationType implementation="io.github.dotnetsupport.frameworks.unity.UnityTestConfigurationType"/>
        <runConfigurationProducer implementation="io.github.dotnetsupport.frameworks.unity.UnityTestConfigurationProducer"/>
        <statusBarWidgetFactory id="DotNet.UnityEditor" implementation="io.github.dotnetsupport.frameworks.unity.UnityEditorStatusWidgetFactory"/>
        <toolWindow id="Unity" anchor="bottom" icon="/icons/unity/unity.svg" doNotActivateOnStart="true"
                    factoryClass="io.github.dotnetsupport.frameworks.unity.UnityLogToolWindowFactory"/>
    </extensions>

    <projectListeners>
        <listener class="io.github.dotnetsupport.frameworks.unity.UnityEditorSaveListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <!-- New → Unity ▸ the entities of Unity, a submenu beside the categories of .NET items, in the folders of a Unity project only -->
        <group id="Unity.NewItems" class="io.github.dotnetsupport.frameworks.unity.UnityNewItemGroup" text="Unity" popup="true" icon="/icons/unity/unity.svg">
            <!-- right after Class/Interface, before the categories of .NET items: the first thing of New in a Unity project, as in Rider -->
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="DotNet.NewCSharpFile"/>
        </group>
        <action id="Unity.ShowMetaFiles" class="io.github.dotnetsupport.frameworks.unity.ShowMetaFilesAction"
                text="Show .meta Files" description="Show the .meta files of a Unity project in the Solution view">
            <add-to-group group-id="ProjectView.ToolWindow.SecondaryActions" anchor="after" relative-to-action="DotNet.ShowAllFiles"/>
        </action>
        <action id="Unity.OpenInEditor" class="io.github.dotnetsupport.frameworks.unity.OpenInUnityAction"
                text="Open in Unity Editor" description="Open the project in the Unity editor of its version (installed by Unity Hub)">
            <add-to-group group-id="DotNet.MainMenu" anchor="last"/>
            <add-to-group group-id="DotNet.SolutionViewPopup" anchor="last"/>
        </action>
        <!-- the editor of a Unity project from the IDE, as Rider's Play / Pause / Step: in the .NET menu, the popup of the status bar widget
             and the main toolbar before the Run widget; hidden in other projects -->
        <action id="Unity.Play" class="io.github.dotnetsupport.frameworks.unity.UnityPlayAction"/>
        <action id="Unity.Pause" class="io.github.dotnetsupport.frameworks.unity.UnityPauseAction"/>
        <action id="Unity.Step" class="io.github.dotnetsupport.frameworks.unity.UnityStepAction"/>
        <action id="Unity.RefreshAssets" class="io.github.dotnetsupport.frameworks.unity.UnityRefreshAction"/>
        <action id="Unity.AttachDebugger" class="io.github.dotnetsupport.frameworks.unity.UnityAttachDebuggerAction"/>
        <action id="Unity.DebugMode" class="io.github.dotnetsupport.frameworks.unity.UnityDebugModeAction"/>
        <action id="Unity.InstallEditorPackage" class="io.github.dotnetsupport.frameworks.unity.UnityInstallPackageAction"/>
        <action id="Unity.UseAsExternalEditor" class="io.github.dotnetsupport.frameworks.unity.UnityUseAsExternalEditorAction"/>
        <action id="Unity.RestoreExternalEditor" class="io.github.dotnetsupport.frameworks.unity.UnityRestoreExternalEditorAction"/>
        <action id="Unity.ShowLog" class="io.github.dotnetsupport.frameworks.unity.UnityShowLogAction" text="Show Unity Log"
                description="The console of the Unity editor: its messages and the errors of its compilation" icon="/icons/unity/unity.svg"/>
        <group id="Unity.EditorActions">
            <reference ref="Unity.Play"/>
            <reference ref="Unity.Pause"/>
            <reference ref="Unity.Step"/>
            <reference ref="Unity.RefreshAssets"/>
            <reference ref="Unity.AttachDebugger"/>
            <reference ref="Unity.DebugMode"/>
            <reference ref="Unity.InstallEditorPackage"/>
            <reference ref="Unity.ShowLog"/>
            <reference ref="Unity.UseAsExternalEditor"/>
            <reference ref="Unity.RestoreExternalEditor"/>
            <reference ref="Unity.OpenInEditor"/>
            <add-to-group group-id="DotNet.MainMenu" anchor="last"/>
        </group>
        <group id="Unity.EditorToolbar">
            <reference ref="Unity.Play"/>
            <reference ref="Unity.Pause"/>
            <reference ref="Unity.Step"/>
            <reference ref="Unity.AttachDebugger"/>
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="NewUiRunWidget"/>
        </group>

    </actions>
</idea-plugin>
