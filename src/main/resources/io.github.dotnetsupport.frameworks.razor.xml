<!-- A framework module of the plugin (RAZOR_PLAN.md, "Модульность"): Razor and Blazor (.razor, .cshtml; RAZOR_PLAN.md). Classes: io.github.dotnetsupport.frameworks.razor only;
     the core of C# knows nothing of them and hears from them through its extension points (io.github.dotnetsupport.csharp*). -->
<idea-plugin package="io.github.dotnetsupport.frameworks.razor">
    <extensions defaultExtensionNs="io.github.dotnetsupport">
        <csharpCodeGenerators implementation="io.github.dotnetsupport.frameworks.razor.RazorCodeGenerators"/>
        <!-- the rename of a component's class or a parameter writes its tags and attributes in the markup, the .razor file of a code-behind -->
        <csharpRenameParticipant implementation="io.github.dotnetsupport.frameworks.razor.RazorRenameParticipant"/>
    </extensions>

    <!-- R1: the language — Razor the base, HTML the template data, the C# coloured by the plugin's C# lexer -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorFileType" fieldName="INSTANCE"
                  language="Razor" extensions="razor;cshtml"/>
        <lang.parserDefinition language="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorParserDefinition"/>
        <lang.fileViewProviderFactory language="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorFileViewProviderFactory"/>
        <lang.syntaxHighlighterFactory language="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorSyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorEditorHighlighterProvider"/>
        <colorSettingsPage implementation="io.github.dotnetsupport.frameworks.razor.RazorColorSettingsPage"/>
        <lang.braceMatcher language="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorBraceMatcher"/>
        <lang.commenter language="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorCommenter"/>
        <!-- Ctrl+/ on markup gives @* *@, not the comment of HTML; `//` in @code -->
        <multiLangCommenter implementation="io.github.dotnetsupport.frameworks.razor.RazorCommentProvider"/>
        <lang.foldingBuilder language="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorFoldingBuilder"/>
        <lang.psiStructureViewFactory language="Razor" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorStructureViewFactory"/>
        <highlightErrorFilter implementation="io.github.dotnetsupport.frameworks.razor.RazorErrorFilter"/>
        <daemon.highlightInfoFilter implementation="io.github.dotnetsupport.frameworks.razor.RazorHtmlStructureFilter"/>
        <lang.inspectionSuppressor language="HTML" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorHtmlInspectionSuppressor"/>
        <!-- R3: the virtual C# document — one injection of the C# pieces of the file -->
        <multiHostInjector implementation="io.github.dotnetsupport.frameworks.razor.RazorCSharpInjector"/>
        <!-- R5e: the components and tag helpers in the markup -->
        <!-- before XmlCompletionContributor: on a repeated Ctrl+Space it completes tag names from the schemas and stops the others (none in Razor) -->
        <completion.contributor language="HTML" order="first, before xml" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorTagHelperCompletionContributor"/>
        <gotoDeclarationHandler implementation="io.github.dotnetsupport.frameworks.razor.RazorTagHelperGotoDeclarationHandler"/>
        <!-- R5e part 2: Find Usages of a component (its .razor file, its class) and of a parameter finds its tags and attributes;
             Alt+F7 / Shift+F6 on them in the markup search / rename the component or the parameter, not the HTML element -->
        <referencesSearch implementation="io.github.dotnetsupport.frameworks.razor.RazorMarkupReferencesSearcher"/>
        <!-- the names of the markup are tokens of XML: the evaluator of XML is asked, this one extends it -->
        <targetElementEvaluator language="XML" order="first" implementationClass="io.github.dotnetsupport.frameworks.razor.RazorHtmlTargetElementEvaluator"/>
        <findUsagesHandlerFactory order="first" implementation="io.github.dotnetsupport.frameworks.razor.RazorMarkupFindUsagesHandlerFactory"/>
        <usageTypeProvider implementation="io.github.dotnetsupport.frameworks.razor.RazorMarkupUsageTypeProvider"/>
        <renameHandler order="first" implementation="io.github.dotnetsupport.frameworks.razor.RazorMarkupRenameHandler"/>
        <vetoRenameCondition implementation="io.github.dotnetsupport.frameworks.razor.RazorMarkupVetoRename"/>
    </extensions>
</idea-plugin>
