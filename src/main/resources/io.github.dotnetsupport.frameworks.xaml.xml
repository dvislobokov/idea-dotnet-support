<!-- A framework module of the plugin (RAZOR_PLAN.md, "Модульность"): XAML of WPF, MAUI, Uno and UWP. Classes: io.github.dotnetsupport.frameworks.xaml only;
     the core of C# knows nothing of them and hears from them through its extension points (io.github.dotnetsupport.csharp*). -->
<idea-plugin package="io.github.dotnetsupport.frameworks.xaml">
    <extensions defaultExtensionNs="io.github.dotnetsupport">
        <csharpCodeGenerators implementation="io.github.dotnetsupport.frameworks.xaml.XamlCodeGenerators"/>
    </extensions>
</idea-plugin>
