<!-- A framework module of the plugin (RAZOR_PLAN.md, "Модульность"): gRPC (Grpc.Tools, .proto). Classes: io.github.dotnetsupport.frameworks.grpc only;
     the core of C# knows nothing of them and hears from them through its extension points (io.github.dotnetsupport.csharp*). -->
<idea-plugin package="io.github.dotnetsupport.frameworks.grpc">
    <extensions defaultExtensionNs="io.github.dotnetsupport">
        <csharpCodeGenerators implementation="io.github.dotnetsupport.frameworks.grpc.GrpcCodeGenerators"/>
    </extensions>
</idea-plugin>
