<!-- A framework module of the plugin (RAZOR_PLAN.md, "Модульность"): the JSON files of Unity (UNITY_PLAN.md) — assembly definitions
     (.asmdef) and references (.asmref) as JSON with their schema, the names in "references" completed and navigable. Needs the JSON plugin
     (a plugin of its own since 2024.3): where it is missing only this part is off. Classes: io.github.dotnetsupport.frameworks.unityjson only. -->
<idea-plugin package="io.github.dotnetsupport.frameworks.unityjson">
    <dependencies>
        <plugin id="com.intellij.modules.json"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="JSON" extensions="asmdef;asmref"/>
        <psi.referenceContributor language="JSON" implementation="io.github.dotnetsupport.frameworks.unityjson.AssemblyDefinitionReferenceContributor"/>
        <localInspection language="JSON" shortName="UnityAssemblyDefinitionReference" displayName="Unknown assembly definition reference"
                         groupPath="C#" groupName="Unity" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.dotnetsupport.frameworks.unityjson.AssemblyDefinitionReferenceInspection"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="io.github.dotnetsupport.frameworks.unityjson.AssemblyDefinitionSchemaProviderFactory"/>
    </extensions>
</idea-plugin>
