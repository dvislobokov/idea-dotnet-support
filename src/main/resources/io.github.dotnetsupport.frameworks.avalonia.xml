<!-- A framework module of the plugin (RAZOR_PLAN.md, "Модульность"): Avalonia (.axaml). Classes: io.github.dotnetsupport.frameworks.avalonia only;
     the core of C# knows nothing of them and hears from them through its extension points (io.github.dotnetsupport.csharp*). -->
<idea-plugin package="io.github.dotnetsupport.frameworks.avalonia">
    <extensions defaultExtensionNs="io.github.dotnetsupport">
        <csharpCodeGenerators implementation="io.github.dotnetsupport.frameworks.avalonia.AvaloniaCodeGenerators"/>
    </extensions>
</idea-plugin>
