{
  "about": "The sections of appsettings.json every ASP.NET Core / Generic Host program reads, for when the schema of SchemaStore is not used (remote JSON schemas are off in the IDE). Kept small: only what the framework itself binds. appsettings/AppSettingsSchemas merges it with the packages and the code.",
  "properties": {
    "Logging": {
      "type": "object",
      "description": "Logging configuration (Microsoft.Extensions.Logging): minimal levels by category, per provider.",
      "properties": {
        "LogLevel": {
          "type": "object",
          "description": "The minimal level of a category, the longest matching prefix wins; Default for the rest.",
          "properties": {
            "Default": { "$ref": "#/definitions/logLevel" }
          },
          "additionalProperties": { "$ref": "#/definitions/logLevel" }
        },
        "Console": { "$ref": "#/definitions/logProvider" },
        "Debug": { "$ref": "#/definitions/logProvider" },
        "EventSource": { "$ref": "#/definitions/logProvider" },
        "EventLog": { "$ref": "#/definitions/logProvider" }
      },
      "additionalProperties": { "$ref": "#/definitions/logProvider" }
    },
    "ConnectionStrings": {
      "type": "object",
      "description": "Connection strings by name, read with IConfiguration.GetConnectionString(name).",
      "additionalProperties": { "type": "string" }
    },
    "AllowedHosts": {
      "type": "string",
      "description": "Host names the host filtering middleware lets in, separated by semicolons; * for any.",
      "default": "*"
    },
    "Kestrel": {
      "type": "object",
      "description": "The Kestrel web server: endpoints, certificates, limits.",
      "properties": {
        "Endpoints": {
          "type": "object",
          "description": "Endpoints by name.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "Url": { "type": "string", "description": "The address to listen on, e.g. https://localhost:5001 or http://*:80." },
              "Protocols": { "$ref": "#/definitions/protocols" },
              "SslProtocols": { "type": "array", "items": { "type": "string", "enum": ["None", "Tls", "Tls11", "Tls12", "Tls13"] } },
              "Certificate": { "$ref": "#/definitions/certificate" },
              "ClientCertificateMode": { "type": "string", "enum": ["NoCertificate", "AllowCertificate", "RequireCertificate", "DelayCertificate"] }
            },
            "required": ["Url"]
          }
        },
        "EndpointDefaults": {
          "type": "object",
          "properties": {
            "Protocols": { "$ref": "#/definitions/protocols" },
            "SslProtocols": { "type": "array", "items": { "type": "string", "enum": ["None", "Tls", "Tls11", "Tls12", "Tls13"] } },
            "ClientCertificateMode": { "type": "string", "enum": ["NoCertificate", "AllowCertificate", "RequireCertificate", "DelayCertificate"] }
          }
        },
        "Certificates": {
          "type": "object",
          "description": "Certificates by name; Default is used by HTTPS endpoints without a certificate of their own.",
          "additionalProperties": { "$ref": "#/definitions/certificate" }
        },
        "Limits": {
          "type": "object",
          "properties": {
            "MaxConcurrentConnections": { "type": ["integer", "null"] },
            "MaxConcurrentUpgradedConnections": { "type": ["integer", "null"] },
            "MaxRequestBodySize": { "type": ["integer", "null"], "default": 30000000 },
            "MaxRequestHeaderCount": { "type": "integer", "default": 100 },
            "MaxRequestHeadersTotalSize": { "type": "integer", "default": 32768 },
            "MaxRequestLineSize": { "type": "integer", "default": 8192 },
            "MaxResponseBufferSize": { "type": ["integer", "null"], "default": 65536 },
            "KeepAliveTimeout": { "type": "string", "default": "00:02:10" },
            "RequestHeadersTimeout": { "type": "string", "default": "00:00:30" }
          }
        },
        "AllowSynchronousIO": { "type": "boolean", "default": false },
        "AddServerHeader": { "type": "boolean", "default": true },
        "DisableStringReuse": { "type": "boolean", "default": false }
      }
    }
  },
  "definitions": {
    "logLevel": {
      "type": "string",
      "enum": ["Trace", "Debug", "Information", "Warning", "Error", "Critical", "None"]
    },
    "logProvider": {
      "type": "object",
      "properties": {
        "LogLevel": {
          "type": "object",
          "properties": { "Default": { "$ref": "#/definitions/logLevel" } },
          "additionalProperties": { "$ref": "#/definitions/logLevel" }
        }
      }
    },
    "protocols": {
      "type": "string",
      "enum": ["None", "Http1", "Http2", "Http1AndHttp2", "Http3", "Http1AndHttp2AndHttp3"]
    },
    "certificate": {
      "type": "object",
      "properties": {
        "Path": { "type": "string", "description": "A .pfx or .pem file." },
        "KeyPath": { "type": "string", "description": "The key of a .pem certificate." },
        "Password": { "type": "string" },
        "Subject": { "type": "string", "description": "A certificate of the store, by subject." },
        "Store": { "type": "string", "default": "My" },
        "Location": { "type": "string", "enum": ["CurrentUser", "LocalMachine"], "default": "CurrentUser" },
        "AllowInvalid": { "type": "boolean", "default": false }
      }
    }
  }
}
