{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "Position": {
        "type": "object",
        "description": "The position of the window on the screen.",
        "properties": {
          "Title": {
            "type": "string",
            "description": "The title of the window.",
            "default": "Playground"
          },
          "Height": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*[-+]?\\d+\\s*$",
            "description": "Height in pixels.",
            "default": 480
          },
          "Maximized": {
            "type": [
              "boolean",
              "string"
            ],
            "pattern": "^\\s*([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])\\s*$"
          }
        },
        "x-dotnet-type": "Playground.Editor.PositionOptions"
      },
      "Shop": {
        "type": "object",
        "description": "Settings of the shop.",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Shown in the title bar.",
            "default": ""
          },
          "Mode": {
            "type": "string",
            "enum": [
              "Fast",
              "Cheap",
              "Balanced"
            ],
            "description": "How orders are shipped.\nFast: The next day.",
            "default": "Balanced"
          },
          "Timeout": {
            "type": "string",
            "pattern": "^\\s*-?(\\d+|(\\d+\\.)?\\d{1,2}:\\d{1,2}(:\\d{1,2}(\\.\\d{1,7})?)?)\\s*$",
            "description": "How long a checkout may take.\nTimeSpan: [d.]hh:mm[:ss[.fffffff]]",
            "default": "00:00:30"
          },
          "Tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "new",
              "sale"
            ]
          },
          "Prices": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^\\s*[-+]?(\\d+\\.?\\d*|\\.\\d+)([eE][-+]?\\d+)?\\s*$"
            },
            "description": "Price by the name of the product."
          },
          "Retry": {
            "type": "object",
            "description": "How a failed call is retried.",
            "properties": {
              "Count": {
                "type": [
                  "integer",
                  "string"
                ],
                "pattern": "^\\s*[-+]?\\d+\\s*$",
                "description": "Attempts after the first one.",
                "default": 3
              },
              "Delay": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\s*-?(\\d+|(\\d+\\.)?\\d{1,2}:\\d{1,2}(:\\d{1,2}(\\.\\d{1,7})?)?)\\s*$",
                "description": "TimeSpan: [d.]hh:mm[:ss[.fffffff]]"
              }
            },
            "x-dotnet-type": "Playground.Editor.RetryOptions"
          },
          "Owner": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "Name": {
                "type": "string"
              },
              "Age": {
                "type": [
                  "integer",
                  "string"
                ],
                "pattern": "^\\s*[-+]?\\d+\\s*$",
                "default": 30
              }
            },
            "x-dotnet-type": "Playground.Editor.ShopOwner"
          }
        },
        "x-dotnet-type": "Playground.Editor.ShopOptions"
      },
      "Features": {
        "type": "object",
        "properties": {
          "Beta": {
            "type": "object",
            "properties": {
              "Enabled": {
                "type": [
                  "boolean",
                  "string"
                ],
                "pattern": "^\\s*([Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee])\\s*$"
              },
              "Id": {
                "type": "string",
                "pattern": "^[{(]?[0-9A-Fa-f]{8}-?[0-9A-Fa-f]{4}-?[0-9A-Fa-f]{4}-?[0-9A-Fa-f]{4}-?[0-9A-Fa-f]{12}[)}]?$"
              }
            },
            "x-dotnet-type": "Playground.Editor.FeatureOptions"
          }
        }
      },
      "Limits": {
        "type": "object",
        "properties": {
          "TimeoutSeconds": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^\\s*[-+]?\\d+\\s*$",
            "default": 30
          },
          "Greeting": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "Cache": {
        "type": "object",
        "properties": {
          "Redis": {
            "type": "object",
            "properties": {
              "SizeMb": {
                "type": [
                  "integer",
                  "string"
                ],
                "pattern": "^\\s*[-+]?\\d+\\s*$",
                "default": 64
              },
              "Endpoints": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "x-dotnet-type": "Playground.Editor.CacheOptions"
          }
        }
      }
    }
  },
