<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The NuGet credential provider of the plugin (helpers/README.md, nuget/NuGetKeychain): the passwords of private feeds live in the keychain
    of the OS, not in nuget.config, and every `dotnet restore` finds them, in the IDE and in any terminal. NuGet runs it from
    ~/.nuget/plugins/netcore/CredentialProvider.DotNetSupport/ (the folder and the dll must have the same name), the plugin runs it to store,
    read and erase a password.

    No packages: a provider that needs the feed to be built could not be built behind the very feed it gives the password of.
    The plugin carries this file and the *.cs next to it and builds them on the machine of the user (cli/DotNetHelper) for the framework of
    the SDK that is there: `-p:HelperFramework=net10.0` with the SDK 10. Without the property (a build in the repository): net8.0.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(HelperFramework)' != ''">$(HelperFramework)</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CredentialProvider.DotNetSupport</AssemblyName>
    <RootNamespace>DotNetSupport.CredentialProvider</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <UseAppHost>false</UseAppHost>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
</Project>
