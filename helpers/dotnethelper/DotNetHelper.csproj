<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The helper of the plugin for what the .NET libraries do better than the plugin: first the NuGet client (nuget/NuGetHelper). It goes
    to the feeds the way the dotnet CLI does: the proxy of the system and of nuget.config, the certificates of the OS, the credentials
    of nuget.config and of the credential providers (Azure Artifacts and the like). A helper that stays running (helpers/README.md).

    NuGet.Protocol brings NuGet.Configuration, NuGet.Packaging, NuGet.Versioning and NuGet.Common; NuGet.Credentials the providers
    of credentials. ICSharpCode.Decompiler (MIT, the engine of ILSpy) disassembles for the IL viewer (Il.cs); it needs only
    System.Reflection.Metadata and System.Collections.Immutable, nothing NuGet.* uses. Nothing of MSBuild: it lives in MsBuildHost, whose MSBuild loads NuGet assemblies of its own.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(HelperFramework)' != ''">$(HelperFramework)</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DotNetHelper</AssemblyName>
    <RootNamespace>DotNetSupport.Helpers.DotNetHelper</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../protocol/Protocol.cs" Condition="!Exists('Protocol.cs')" Link="Protocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" Version="6.14.3" />
    <PackageReference Include="NuGet.Credentials" Version="6.14.3" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" /><!-- the parser only: AppSettings.cs -->
  </ItemGroup>
</Project>
