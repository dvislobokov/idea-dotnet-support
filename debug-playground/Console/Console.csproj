<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Playground</RootNamespace>
    <AssemblyName>Playground.Console</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lib\Lib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- configuration and options for Editor/AppSettingsSchema.cs (the schema of appsettings.json made from the code) -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.6" />
    <!-- an analyzer package with code fixes for Editor/Analyzers.cs (0.1.77); its rules are off outside that file (.editorconfig) -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Live checks of 0.1.95 (Editor/RareCompletion.cs, README of the playground). Type on the empty line inside the group, undo with Ctrl+Z. -->
  <PropertyGroup>
    <!-- TYPE:msbuild-property — type `<Out>$(MSBuildProj` + Ctrl+Space (Completion = Built-in). EXPECT: `MSBuildProjectDirectory`, `MSBuildProjectName`, ...;
         `$(Root` offers `RootNamespace` (declared above); the parenthesis is closed on choosing. `@(Comp` → `Compile`, `%(File` → `Filename`. -->

    <!-- TYPE:msbuild-paths — directly under <Project>, outside of the groups (type `<Import Project="` + Ctrl+Space): `..\` and the folders of Console, files .props / .targets / .csproj; after `..\Lib\`
         only Lib.csproj; the same in `<ProjectReference Include="..\Lib\`: project files only. NOT: .cs files, bin, obj. -->

  </PropertyGroup>
</Project>
