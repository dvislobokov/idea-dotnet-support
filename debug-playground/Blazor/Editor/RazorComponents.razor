<h3>Components</h3>
<Counter Step="@step" CountChanged="OnCount" />

<button @onclick="Reset">Reset</button>
<p>Total: @total</p>

@code {
    private int step = 2;
    private int total;
    private string title = "Counter";

    private void OnCount(int value) => total = value;

    private void Reset() => total = 0;
}
