<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests on Microsoft.Testing.Platform (xunit.v3: the test project is an executable; `dotnet test` of SDK 8 / 9 runs it through the
       platform with TestingPlatformDotnetTestSupport). Debug of a test here: DAP_PLAN.md, layer 4, BP:mtp-test. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Playground.TestsMtp</RootNamespace>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lib\Lib.csproj" />
  </ItemGroup>
</Project>
