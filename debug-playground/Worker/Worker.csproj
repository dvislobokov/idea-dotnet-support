<Project Sdk="Microsoft.NET.Sdk">
  <!-- The second runnable project of the "Compound" scenarios (README): it and Web both reference Lib, so a launch of the two together builds Lib once. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Playground.Worker</RootNamespace>
    <AssemblyName>Playground.Worker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lib\Lib.csproj" />
  </ItemGroup>
</Project>
