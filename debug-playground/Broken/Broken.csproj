<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- broken on purpose for the editor (TYPE:diag-*), not for the build: the Debug scenario of Broken shows only Program.cs -->
    <Compile Remove="SyntaxErrors.cs" />
    <Compile Remove="SemanticErrors.cs" />
    <Compile Remove="SemanticErrors2.cs" />
    <!-- one file per compiler error, lines marked `// ERROR CSxxxx` (tools/diag/check_errors.py) -->
    <Compile Remove="Errors/**" />
  </ItemGroup>
</Project>
